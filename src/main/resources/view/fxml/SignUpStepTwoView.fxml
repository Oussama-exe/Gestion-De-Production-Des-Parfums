<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<!--
  ============================================================
  SIGN UP — STEP 2 / 2  (Personal information)
  ============================================================
  Corresponds to "nom / prenom -> suivant" boxes in the diagram.
  Completes account creation, then proceeds to the verification
  step / HomePage.
-->

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignUpStepTwoController">

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Circle radius="200" styleClass="ambient-orb-one" translateX="420.0" translateY="270.0" />
        <Circle radius="180" styleClass="ambient-orb-two" translateX="-430.0" translateY="-260.0" />

        <VBox alignment="CENTER" maxWidth="460.0" spacing="0.0" styleClass="auth-card">

            <VBox alignment="CENTER" spacing="6.0">
                <Text styleClass="subtitle" text="O S M A R" />
                <Text styleClass="section-title" text="Parlez-nous de vous" />
                <Text styleClass="caption-text" text="Étape 2 sur 2 — informations personnelles" />
            </VBox>

            <!-- Step indicator -->
            <HBox alignment="CENTER" spacing="10.0">
                <padding>
                    <Insets bottom="6.0" top="22.0" />
                </padding>
                <Region styleClass="step-dot-active" />
                <Region prefWidth="36.0" styleClass="step-line" />
                <Region styleClass="step-dot-active" />
            </HBox>

            <VBox spacing="18.0">
                <padding>
                    <Insets top="26.0" />
                </padding>

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="NOM" />
                    <TextField fx:id="nomField" promptText="Votre nom de famille" styleClass="input-field" />
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="PRÉNOM" />
                    <TextField fx:id="prenomField" promptText="Votre prénom" styleClass="input-field" />
                </VBox>

            </VBox>

            <VBox alignment="CENTER" spacing="16.0">
                <padding>
                    <Insets top="34.0" />
                </padding>
                <Button fx:id="nextButton" maxWidth="Infinity" prefHeight="50.0" styleClass="btn-primary" text="Suivant" />
                <Button fx:id="backButton" styleClass="btn-ghost" text="Retour" />
            </VBox>

        </VBox>

    </StackPane>

</AnchorPane>
