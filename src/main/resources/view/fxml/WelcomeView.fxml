<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<!--
  ============================================================
  WELCOME / SPLASH SCREEN   ("Bienvenue sur...")
  ============================================================
  First screen of the application. Brand introduction with a
  "Suivant" (Next) call-to-action leading to the Login screen.
  Fully static layout — wire fx:id handlers in the Controller.
-->

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.WelcomeController">

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- Ambient decorative orbs for depth (purely visual) -->
        <Circle fx:id="orbOne" radius="220" styleClass="ambient-orb-one" translateX="-380.0" translateY="-240.0" />
        <Circle fx:id="orbTwo" radius="260" styleClass="ambient-orb-two" translateX="400.0" translateY="250.0" />

        <!-- Central content column -->
        <VBox alignment="CENTER" maxWidth="560.0" spacing="26.0" StackPane.alignment="CENTER">

            <!-- Logo mark -->
            <StackPane maxHeight="92.0" maxWidth="92.0" prefHeight="92.0" prefWidth="92.0" styleClass="logo-mark">
                <Text styleClass="logo-mark-text" text="E" />
            </StackPane>

            <VBox alignment="CENTER" spacing="10.0">
                <Text styleClass="subtitle" text="M A I S O N   D E   P A R F U M" />
                <Text fx:id="welcomeTitle" styleClass="display-title" text="Bienvenue sur OSMAR" textAlignment="CENTER" wrappingWidth="520.0" />
            </VBox>

            <Region minHeight="3.0" prefHeight="3.0" styleClass="gold-divider-short" />

            <Text styleClass="body-text" text="Composez, commandez et suivez la production de vos parfums sur mesure — du flacon à la livraison." textAlignment="CENTER" wrappingWidth="440.0" />

            <VBox alignment="CENTER" spacing="14.0">
                <padding>
                    <Insets top="22.0" />
                </padding>
                <Button fx:id="nextButton" prefHeight="50.0" prefWidth="220.0" styleClass="btn-primary" text="Suivant" />
                <Text styleClass="caption-text" text="Une expérience olfactive, conçue pour vous" />
            </VBox>

        </VBox>

        <!-- Onboarding step indicator -->
        <HBox alignment="CENTER" maxHeight="20.0" maxWidth="80.0" pickOnBounds="false" spacing="8.0" StackPane.alignment="BOTTOM_CENTER">
            <padding>
                <Insets bottom="40.0" />
            </padding>
            <Region styleClass="step-dot-active" />
            <Region styleClass="step-dot" />
            <Region styleClass="step-dot" />
        </HBox>

    </StackPane>

</AnchorPane>
