<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<!--
  ============================================================
  WELCOME / SPLASH SCREEN   ("Bienvenue sur...")
  ============================================================
  First screen of the application. Brand introduction with a
  "Suivant" (Next) call-to-action leading to the Login screen.
  Fully static layout — wire fx:id handlers in the Controller.
-->
<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.WelcomeController">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Ambient decorative orbs for depth (purely visual) -->
        <Circle fx:id="orbOne" styleClass="ambient-orb-one" radius="220"
                translateX="-380.0" translateY="-240.0"/>
        <Circle fx:id="orbTwo" styleClass="ambient-orb-two" radius="260"
                translateX="400.0" translateY="250.0"/>

        <!-- Central content column -->
        <VBox alignment="CENTER" spacing="26.0" maxWidth="560.0" StackPane.alignment="CENTER">

            <!-- Logo mark -->
            <StackPane styleClass="logo-mark" prefWidth="92.0" prefHeight="92.0"
                       maxWidth="92.0" maxHeight="92.0">
                <Text styleClass="logo-mark-text" text="E"/>
            </StackPane>

            <VBox alignment="CENTER" spacing="10.0">
                <Text styleClass="subtitle" text="M A I S O N   D E   P A R F U M"/>
                <Text fx:id="welcomeTitle" styleClass="display-title" textAlignment="CENTER"
                      wrappingWidth="520.0" text="Bienvenue sur Essence"/>
            </VBox>

            <Region styleClass="gold-divider-short" minHeight="3.0" prefHeight="3.0"/>

            <Text styleClass="body-text" textAlignment="CENTER" wrappingWidth="440.0"
                  text="Composez, commandez et suivez la production de vos parfums sur mesure — du flacon à la livraison."/>

            <VBox alignment="CENTER" spacing="14.0">
                <padding>
                    <Insets top="22.0"/>
                </padding>
                <Button fx:id="nextButton" text="Suivant" styleClass="btn-primary"
                        prefWidth="220.0" prefHeight="50.0"/>
                <Text styleClass="caption-text" text="Une expérience olfactive, conçue pour vous"/>
            </VBox>

        </VBox>

        <!-- Onboarding step indicator -->
        <HBox alignment="CENTER" spacing="8.0" StackPane.alignment="BOTTOM_CENTER"
              maxHeight="20.0" maxWidth="80.0" pickOnBounds="false">
            <padding>
                <Insets bottom="40.0"/>
            </padding>
            <Region styleClass="step-dot-active"/>
            <Region styleClass="step-dot"/>
            <Region styleClass="step-dot"/>
        </HBox>

    </StackPane>

</AnchorPane>
