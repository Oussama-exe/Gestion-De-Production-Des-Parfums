<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<!--
  ============================================================
  COMPOSITION SUMMARY  ("présentation...")
  ============================================================
  Recap of the chosen ingredients (ing1..ingr4) with the option
  to "modifier" (edit, goes back to Catalog) or "suivant"
  (proceed to Payment).
-->
<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CompositionSummaryController">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <Circle styleClass="ambient-orb-one" radius="220" translateX="400.0" translateY="-220.0"/>
        <Circle styleClass="ambient-orb-two" radius="200" translateX="-420.0" translateY="240.0"/>

        <VBox alignment="CENTER" styleClass="glass-card" maxWidth="540.0" maxHeight="620.0" spacing="0.0">
            <padding>
                <Insets top="44.0" bottom="36.0" left="48.0" right="48.0"/>
            </padding>

            <!-- Step indicator -->
            <HBox alignment="CENTER" spacing="8.0">
                <Region styleClass="step-dot-active"/>
                <Region styleClass="step-line" prefWidth="28.0"/>
                <Region styleClass="step-dot-active"/>
                <Region styleClass="step-line" prefWidth="28.0"/>
                <Region styleClass="step-dot-active"/>
                <Region styleClass="step-line" prefWidth="28.0"/>
                <Region styleClass="step-dot"/>
            </HBox>

            <VBox alignment="CENTER" spacing="8.0">
                <padding>
                    <Insets top="22.0" bottom="20.0"/>
                </padding>
                <Text styleClass="subtitle" text="É T A P E   4"/>
                <Text styleClass="section-title" text="Votre composition"/>
                <Text fx:id="summaryCaptionText" styleClass="caption-text" text="0 ml · 0 essence sélectionnée"/>
            </VBox>

            <!-- Ingredient list — populated dynamically by
                 CompositionSummaryController from
                 Session.getCurrentCommande().getElementsCmd() -->
            <ScrollPane fitToWidth="true" styleClass="clean-scroll" maxHeight="280.0">
                <VBox fx:id="ingredientRowsContainer" spacing="12.0"/>
            </ScrollPane>

            <HBox alignment="CENTER" spacing="14.0">
                <padding>
                    <Insets top="28.0"/>
                </padding>
                <Button fx:id="modifyButton" text="Modifier" styleClass="btn-secondary"
                        prefWidth="160.0" prefHeight="48.0"/>
                <Button fx:id="nextButton" text="Suivant" styleClass="btn-primary"
                        prefWidth="200.0" prefHeight="48.0"/>
            </HBox>

        </VBox>

    </StackPane>

</AnchorPane>
