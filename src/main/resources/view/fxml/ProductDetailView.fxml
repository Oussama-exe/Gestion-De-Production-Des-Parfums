<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!--
  ============================================================
  PRODUCT DETAIL MODAL
  ============================================================
  Opens when a product card is selected from the Catalog.
  Shows photo, full description, and the "Ajouter à la commande"
  action. Designed to be hosted inside a StackPane overlay or a
  separate Stage (modal dialog) on top of CatalogView.
-->
<StackPane fx:id="overlayRoot" prefHeight="800.0" prefWidth="1280.0"
           style="-fx-background-color: rgba(43,36,32,0.45);"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.ProductDetailController">

    <HBox styleClass="glass-card" maxWidth="760.0" maxHeight="460.0" spacing="0.0">

        <!-- Photo panel -->
        <StackPane styleClass="product-image-frame" prefWidth="320.0"
                   style="-fx-background-radius: 24px 0 0 24px;">
            <Text fx:id="emojiText" text="🌸" style="-fx-font-size: 96px;"/>

            <Button fx:id="closeButton" text="✕" styleClass="btn-icon-circle"
                    StackPane.alignment="TOP_RIGHT" prefWidth="34.0" prefHeight="34.0"
                    minWidth="34.0" minHeight="34.0" maxWidth="34.0" maxHeight="34.0">
                <StackPane.margin>
                    <Insets top="16.0" right="16.0"/>
                </StackPane.margin>
            </Button>
        </StackPane>

        <!-- Details panel -->
        <VBox spacing="16.0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="36.0" bottom="32.0" left="36.0" right="36.0"/>
            </padding>

            <Text fx:id="tagText" styleClass="product-tag" text="BEST-SELLER"/>

            <VBox spacing="6.0">
                <Text fx:id="nameText" styleClass="section-title" text="Pivoine Royale"/>
                <Text fx:id="categoryText" styleClass="caption-text" text="Eau de Parfum · Florale poudrée"/>
            </VBox>

            <Region styleClass="gold-divider-short" minHeight="3.0" prefHeight="3.0"/>

            <Text fx:id="descriptionText" styleClass="body-text" wrappingWidth="380.0"
                  text="Une signature florale élégante, où la pivoine éclatante se mêle au musc blanc et au bois de santal pour une fragrance ronde et chaleureuse, idéale au quotidien."/>

            <HBox spacing="10.0">
                <padding>
                    <Insets top="4.0"/>
                </padding>
                <Text styleClass="caption-text" text="Disponibilité :"/>
                <Text fx:id="availabilityText" styleClass="caption-text" text="En stock" style="-fx-font-weight:bold;"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Text fx:id="priceText" styleClass="product-price" style="-fx-font-size: 20px;" text="38€"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addToCartButton" text="Ajouter à la commande" styleClass="btn-primary"
                        prefHeight="48.0"/>
            </HBox>

        </VBox>

    </HBox>

</StackPane>
