<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<!--
  ============================================================
  ORDER CONFIRMATION  ("Commande est bien...")
  ============================================================
  Final success screen. Offers "Ajouter autre commande" and
  "Revenir HomePage" actions.
-->
<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.OrderConfirmationController">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <Circle styleClass="ambient-orb-one" radius="240" translateX="-380.0" translateY="-240.0"/>
        <Circle styleClass="ambient-orb-two" radius="220" translateX="400.0" translateY="240.0"/>

        <VBox alignment="CENTER" spacing="22.0" maxWidth="520.0">

            <StackPane styleClass="success-circle" prefWidth="96.0" prefHeight="96.0"
                       maxWidth="96.0" maxHeight="96.0">
                <Text text="✓" style="-fx-font-size: 44px; -fx-fill: white; -fx-font-weight: bold;"/>
            </StackPane>

            <VBox alignment="CENTER" spacing="10.0">
                <padding>
                    <Insets top="8.0"/>
                </padding>
                <Text styleClass="subtitle" text="M E R C I   P O U R   V O T R E   C O N F I A N C E"/>
                <Text styleClass="display-title" textAlignment="CENTER" wrappingWidth="480.0"
                      text="Votre commande est bien confirmée"/>
            </VBox>

            <Text styleClass="body-text" textAlignment="CENTER" wrappingWidth="420.0"
                  text="Votre parfum sur mesure entre en production. Vous recevrez un e-mail de suivi dès son expédition."/>

            <HBox alignment="CENTER" styleClass="order-id-chip">
                <Text styleClass="order-id-text" text="Commande N° ESN-20260620-0147"/>
            </HBox>

            <HBox alignment="CENTER" spacing="14.0">
                <padding>
                    <Insets top="20.0"/>
                </padding>
                <Button fx:id="addOtherOrderButton" text="Ajouter une autre commande" styleClass="btn-secondary"
                        prefHeight="50.0"/>
                <Button fx:id="backHomeButton" text="Revenir à l'accueil" styleClass="btn-primary"
                        prefHeight="50.0"/>
            </HBox>

        </VBox>

    </StackPane>

</AnchorPane>
