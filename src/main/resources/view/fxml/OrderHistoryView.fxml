<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!--
  ============================================================
  ORDER HISTORY  ("Historique Client")
  ============================================================
  TableView listing the client's past orders, with a back
  action returning to the HomePage.
-->
<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.OrderHistoryController">

    <VBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" spacing="0.0">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <padding>
                <Insets top="36.0" bottom="20.0" left="48.0" right="48.0"/>
            </padding>

            <Button fx:id="backButton" text="‹ Retour" styleClass="btn-ghost"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox spacing="6.0">
            <padding>
                <Insets left="48.0" right="48.0"/>
            </padding>
            <Text styleClass="subtitle" text="V O T R E   P A R C O U R S"/>
            <Text styleClass="display-title" text="Historique des commandes"/>
            <Text styleClass="caption-text" text="Retrouvez ici l'ensemble de vos créations passées"/>
        </VBox>

        <!-- Table card -->
        <VBox styleClass="glass-card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="28.0" bottom="28.0" left="28.0" right="28.0"/>
            </padding>
            <VBox.margin>
                <Insets top="28.0" bottom="36.0" left="48.0" right="48.0"/>
            </VBox.margin>

            <TableView fx:id="ordersTable" styleClass="elegant-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colOrderId" text="N° Commande" prefWidth="140.0"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="140.0"/>
                    <TableColumn fx:id="colParfum" text="Parfum" prefWidth="220.0"/>
                    <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="100.0"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="120.0"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="140.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </VBox>

    </VBox>

</AnchorPane>
