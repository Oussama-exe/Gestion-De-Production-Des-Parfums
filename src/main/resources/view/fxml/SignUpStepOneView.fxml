<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<!--
  ============================================================
  SIGN UP — STEP 1 / 2  (Account credentials)
  ============================================================
  Corresponds to the "SignIn" boxes in the architecture diagram
  (email, pwd, confirmer pwd -> "créer mon compte"). Step 2
  collects nom/prénom (see SignUpStepTwoView.fxml).
-->
<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.SignUpStepOneController">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <Circle styleClass="ambient-orb-one" radius="200" translateX="420.0" translateY="270.0"/>
        <Circle styleClass="ambient-orb-two" radius="180" translateX="-430.0" translateY="-260.0"/>

        <VBox alignment="CENTER" styleClass="auth-card" maxWidth="460.0" spacing="0.0">

            <VBox alignment="CENTER" spacing="6.0">
                <Text styleClass="subtitle" text="E S S E N C E"/>
                <Text styleClass="section-title" text="Créer votre compte"/>
                <Text styleClass="caption-text" text="Étape 1 sur 2 — identifiants de connexion"/>
            </VBox>

            <!-- Step indicator -->
            <HBox alignment="CENTER" spacing="10.0">
                <padding>
                    <Insets top="22.0" bottom="6.0"/>
                </padding>
                <Region styleClass="step-dot-active"/>
                <Region styleClass="step-line" prefWidth="36.0"/>
                <Region styleClass="step-dot"/>
            </HBox>

            <VBox spacing="18.0">
                <padding>
                    <Insets top="26.0"/>
                </padding>

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="ADRESSE E-MAIL"/>
                    <TextField fx:id="emailField" styleClass="input-field" promptText="vous@exemple.com"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="MOT DE PASSE"/>
                    <PasswordField fx:id="pwdField" styleClass="input-password" promptText="8 caractères minimum"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="CONFIRMER LE MOT DE PASSE"/>
                    <PasswordField fx:id="confirmPwdField" styleClass="input-password" promptText="••••••••"/>
                </VBox>

            </VBox>

            <VBox alignment="CENTER" spacing="16.0">
                <padding>
                    <Insets top="30.0"/>
                </padding>
                <Text fx:id="errorText" styleClass="error-text" managed="false" visible="false"
                      text="Les mots de passe ne correspondent pas."/>
                <Button fx:id="createAccountButton" text="Créer mon compte" styleClass="btn-primary"
                        maxWidth="Infinity" prefHeight="50.0"/>
            </VBox>

            <HBox alignment="CENTER" spacing="6.0">
                <padding>
                    <Insets top="22.0"/>
                </padding>
                <Text styleClass="caption-text" text="Déjà membre ?"/>
                <Label fx:id="loginLink" styleClass="link-text" text="Se connecter"/>
            </HBox>

        </VBox>

    </StackPane>

</AnchorPane>
