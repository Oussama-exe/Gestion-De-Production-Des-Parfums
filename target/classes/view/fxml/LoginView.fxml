<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<!--
  ============================================================
  LOGIN SCREEN
  ============================================================
  Email + password sign-in. Links to "SignIn" (account creation,
  here used in the French sense of "S'inscrire") and a forgot
  password affordance.
-->

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Circle radius="200" styleClass="ambient-orb-one" translateX="-420.0" translateY="280.0" />
        <Circle radius="180" styleClass="ambient-orb-two" translateX="430.0" translateY="-260.0" />

        <VBox alignment="CENTER" maxWidth="440.0" spacing="0.0" styleClass="auth-card">

            <VBox alignment="CENTER" spacing="6.0">
                <Text styleClass="subtitle" text="ESSENCE" />
                <Text styleClass="section-title" text="Content de vous revoir" />
                <Text styleClass="caption-text" text="Connectez-vous pour continuer votre commande" />
            </VBox>

            <VBox spacing="18.0">
                <padding>
                    <Insets top="34.0" />
                </padding>

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="ADRESSE E-MAIL" />
                    <TextField fx:id="emailField" promptText="vous@exemple.com" styleClass="input-field" />
                </VBox>

                <VBox spacing="8.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="field-label" text="MOT DE PASSE" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="forgotPasswordLink" styleClass="link-text" text="Mot de passe oublié ?" />
                    </HBox>
                    <PasswordField fx:id="pwdField" promptText="••••••••" styleClass="input-password" />
                </VBox>

            </VBox>

            <VBox alignment="CENTER" spacing="16.0">
                <padding>
                    <Insets top="30.0" />
                </padding>
                <Text fx:id="errorText" managed="false" styleClass="error-text" text="Email ou mot de passe incorrect." visible="false" />
                <Button fx:id="loginButton" maxWidth="Infinity" prefHeight="50.0" styleClass="btn-primary" text="Se connecter" />
            </VBox>

            <HBox alignment="CENTER" spacing="10.0">
                <padding>
                    <Insets top="22.0" />
                </padding>
                <Region styleClass="or-separator-line" HBox.hgrow="ALWAYS" />
                <Text styleClass="caption-text" text="ou" />
                <Region styleClass="or-separator-line" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox alignment="CENTER" spacing="6.0">
                <padding>
                    <Insets top="22.0" />
                </padding>
                <Text styleClass="caption-text" text="Nouveau chez Essence ?" />
                <Label fx:id="createAccountLink" styleClass="link-text" text="Créer un compte" />
            </HBox>

        </VBox>

    </StackPane>

</AnchorPane>
