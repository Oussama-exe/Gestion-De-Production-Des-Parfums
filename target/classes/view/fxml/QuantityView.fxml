<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<!--
  ============================================================
  QUANTITY SELECTION  ("Quantite")
  ============================================================
  Lets the client choose the bottle size / quantity for their
  custom blend via a slider and a stepper, then "Confirmer".
-->
<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.QuantityController">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <Circle styleClass="ambient-orb-one" radius="220" translateX="-400.0" translateY="-220.0"/>
        <Circle styleClass="ambient-orb-two" radius="200" translateX="420.0" translateY="240.0"/>

        <VBox alignment="CENTER" styleClass="glass-card" maxWidth="520.0" spacing="0.0">
            <padding>
                <Insets top="52.0" bottom="48.0" left="56.0" right="56.0"/>
            </padding>

            <!-- Step indicator -->
            <HBox alignment="CENTER" spacing="8.0">
                <Region styleClass="step-dot-active"/>
                <Region styleClass="step-line" prefWidth="28.0"/>
                <Region styleClass="step-dot-active"/>
                <Region styleClass="step-line" prefWidth="28.0"/>
                <Region styleClass="step-dot"/>
                <Region styleClass="step-line" prefWidth="28.0"/>
                <Region styleClass="step-dot"/>
            </HBox>

            <VBox alignment="CENTER" spacing="8.0">
                <padding>
                    <Insets top="26.0"/>
                </padding>
                <Text styleClass="subtitle" text="É T A P E   3"/>
                <Text styleClass="section-title" text="Choisissez la quantité"/>
                <Text styleClass="caption-text" textAlignment="CENTER" wrappingWidth="380.0"
                      text="Sélectionnez le format de flacon pour votre création sur mesure"/>
            </VBox>

            <!-- Bottle size visual -->
            <StackPane prefHeight="120.0">
                <padding>
                    <Insets top="30.0" bottom="10.0"/>
                </padding>
                <Text text="🧴" style="-fx-font-size: 64px;"/>
            </StackPane>

            <VBox alignment="CENTER" spacing="6.0">
                <Text fx:id="quantityValueText" styleClass="display-title" text="50 ml"/>
                <Text styleClass="caption-text" text="Format flacon"/>
            </VBox>

            <!-- Slider -->
            <VBox spacing="12.0">
                <padding>
                    <Insets top="28.0" left="10.0" right="10.0"/>
                </padding>
                <Slider fx:id="quantitySlider" min="30.0" max="100.0" value="50.0"
                        styleClass="elegant-slider" majorTickUnit="10.0"/>
                <HBox alignment="CENTER">
                    <Text styleClass="caption-text" text="30 ml"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Text styleClass="caption-text" text="100 ml"/>
                </HBox>
            </VBox>

            <!-- Quick presets -->
            <HBox alignment="CENTER" spacing="12.0">
                <padding>
                    <Insets top="22.0"/>
                </padding>
                <Button fx:id="preset30Button" text="30 ml" styleClass="btn-pill-select"/>
                <Button fx:id="preset50Button" text="50 ml" styleClass="btn-pill-select-active"/>
                <Button fx:id="preset100Button" text="100 ml" styleClass="btn-pill-select"/>
            </HBox>

            <Button fx:id="confirmButton" text="Confirmer" styleClass="btn-primary"
                    maxWidth="Infinity" prefHeight="50.0">
                <VBox.margin>
                    <Insets top="34.0"/>
                </VBox.margin>
            </Button>

        </VBox>

    </StackPane>

</AnchorPane>
